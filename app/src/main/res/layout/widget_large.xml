<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_bg" android:scaleType="fitXY" android:importantForAccessibility="no"/>
<LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:paddingBottom="32dp"><TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="32dp" android:text="@string/widget_brand" android:textSize="17sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="17sp"/><TextView android:id="@+id/widget_caption" android:layout_width="match_parent" android:layout_height="18dp" android:text="@string/widget_brand" android:textSize="12sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="12sp"/><TextView android:id="@+id/widget_days" android:includeFontPadding="false" android:paddingTop="1dp" android:paddingBottom="1dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="@string/widget_hint" android:textSize="54sp" android:textStyle="bold" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="54sp"/><TextView android:id="@+id/widget_date" android:text="@string/widget_date_hint" android:layout_width="match_parent" android:layout_height="16dp" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="11sp"/><TextView android:id="@+id/widget_next" android:text="@string/widget_next_hint" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="6dp" android:textSize="13sp" android:maxLines="2" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="13sp"/></LinearLayout>
<TextView android:id="@+id/widget_config" android:layout_width="56dp" android:layout_height="32dp" android:layout_gravity="bottom|end" android:gravity="center" android:layout_marginEnd="8dp" android:layout_marginBottom="1dp" android:text="@string/widget_configure" android:textSize="12sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="12sp" android:contentDescription="@string/widget_configure"/>
</FrameLayout>