<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_bg" android:scaleType="fitXY" android:importantForAccessibility="no"/>
<LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:paddingBottom="32dp"><TextView android:id="@+id/widget_caption" android:layout_width="match_parent" android:layout_height="18dp" android:text="@string/widget_brand" android:textSize="12sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="12sp"/><TextView android:id="@+id/widget_days" android:includeFontPadding="false" android:paddingTop="1dp" android:paddingBottom="1dp" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="@string/widget_hint" android:textSize="32sp" android:textStyle="bold" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="32sp"/><TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="20dp" android:text="@string/widget_brand" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="14sp"/></LinearLayout>
<TextView android:id="@+id/widget_config" android:layout_width="56dp" android:layout_height="32dp" android:layout_gravity="bottom|end" android:gravity="center" android:layout_marginEnd="8dp" android:layout_marginBottom="1dp" android:text="@string/widget_configure" android:textSize="12sp" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="12sp" android:contentDescription="@string/widget_configure"/>
</FrameLayout>